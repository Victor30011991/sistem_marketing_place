rules_version = '2';
// Regras do banco da Temperei. Cole este texto em Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // só os dois e-mails da loja, com e-mail confirmado pelo Google
    function equipe() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['j.victor.baros.live@gmail.com', 'samara778@gmail.com'];
    }

    // cardápio do cliente: qualquer pessoa lê; só a equipe publica
    match /publico/{doc} {
      allow read: if true;
      allow write: if equipe();
    }

    // pedidos do cardápio: qualquer cliente cria (só com os campos certos e tamanhos limitados); só a equipe lê e muda
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['criado', 'nome', 'telefone', 'endereco', 'obs', 'itens', 'total', 'origem', 'situacao'])
        && request.resource.data.situacao == 'novo'
        && request.resource.data.criado is string && request.resource.data.criado.size() <= 40
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 30
        && request.resource.data.endereco is string && request.resource.data.endereco.size() <= 300
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 500
        && request.resource.data.origem is string && request.resource.data.origem.size() <= 20
        && request.resource.data.itens is list && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 80
        && request.resource.data.total is int && request.resource.data.total >= 0;
      allow read, update, delete: if equipe();
    }

    // tudo da loja (produtos, custos, vendas, lotes): só a equipe
    match /lojas/{loja} {
      allow read, write: if equipe();
      match /{resto=**} {
        allow read, write: if equipe();
      }
    }
  }
}
